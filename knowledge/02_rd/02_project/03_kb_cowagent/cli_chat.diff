 from agent.skills.types import Skill, SkillEntry
 
 
+def _condense_description_for_prompt(desc: str) -> str:
+    """
+    Condense a full skill description to a keyword-level summary for the
+    system prompt, keeping core action + trigger keywords only.
+    
+    Reduces ~300-chars average descriptions to ~100 chars while preserving
+    enough signal for skill matching. Full descriptions remain available
+    in the SKILL.md files (read via the read tool).
+    """
+    import re
+    text = desc.replace('\n', ' ').strip()
+
+    # ── Extract trigger keywords ──────────────────────────────────────
+    trigger_keywords = []
+
+    for pattern in (
+        re.compile(r'(?:Use when|USE WHEN|Triggers?|Trig)[:：]\s*(.*?)$', re.DOTALL),
+        re.compile(r'(?:触发词|触发场景|触发)[：:]\s*(.*?)$', re.DOTALL),
+    ):
+        match = pattern.search(text)
+        if match:
+            raw = match.group(1).strip()
+            # Split by comma, semicolon, bullet, or parenthesized number list
+            parts = re.split(
+                r'(?:[,;，；]|(?:\s*[•\-]\s*)|\s+(?=[\(\[]?\d+[\)\.]))\s*',
+                raw,
+            )
+            for p in parts:
+                p = p.strip()
+                if not p or len(p) < 3:
+                    continue
+                p = re.sub(r'^[\(\[]?\d+[\)\.]?\s*', '', p).strip()
+                if not p or len(p) < 3:
+                    continue
+                p = re.sub(r'\s*[\(\[]\d+[\)\.]?\s*$', '', p).strip()
+                if not p or len(p) < 3:
+                    continue
+                p = p.rstrip('.。')
+                p = p[:40].strip()
+                if p and p not in trigger_keywords:
+                    trigger_keywords.append(p)
+                if len(trigger_keywords) >= 6:
+                    break
+            break
+
+    # Fallback: extract from "当用户……时" pattern
+    if not trigger_keywords:
+        match = re.search(r'当用户(.*?)时', text)
+        if match:
+            kw_text = match.group(1).strip()
+            parts = re.split(r'[,;，；、](?:\s*(?:\d+[\)\.])\s*)?', kw_text)
+            for p in parts:
+                p = p.strip()
+                if not p or len(p) < 3:
+                    continue
+                p = p[:35].strip()
+                if p and p not in trigger_keywords:
+                    trigger_keywords.append(p)
+                if len(trigger_keywords) >= 6:
+                    break
+
+    # ── Extract core action sentence ──────────────────────────────────
+    core = text
+    for pat in (r'\s+Use when', r'\s+USE WHEN', r'\s+Triggers?',
+                r'\s+触发词', r'\s+触发场景'):
+        m = re.search(pat, text)
+        if m:
+            core = text[:m.start()].strip()
+            break
+
+    if len(core) > 100:
+        sents = re.split(r'(?<=[。！？.!?])\s+(?=[A-Z\u4e00-\u9fff])', core)
+        if len(sents) > 1 and len(sents[0]) <= 100:
+            core = sents[0]
+    if len(core) > 100:
+        core = core[:97] + '...'
+
+    # ── Assemble ──────────────────────────────────────────────────────
+    result = core
+    if trigger_keywords:
+        result += ' | ' + ', '.join(trigger_keywords)
+    if len(result) > 200:
+        result = result[:197] + '...'
+    return result
+
+
