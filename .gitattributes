# Git attributes — enforce LF line endings on text files

# Default: auto-detect text, normalize to LF on commit
* text=auto eol=lf

# Explicit text files: always LF in the repo (and on checkout on any OS)
*.md       text eol=lf
*.markdown text eol=lf
*.py       text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.sh       text eol=lf
*.bash     text eol=lf
*.txt      text eol=lf
*.toml     text eol=lf
*.cfg      text eol=lf
*.ini      text eol=lf
*.conf     text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.ts       text eol=lf
*.jsx      text eol=lf
*.tsx      text eol=lf
*.sql      text eol=lf
*.csv      text eol=lf

# Windows-only scripts: keep CRLF (these MUST run on Windows shells)
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Binary files (never normalize)
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.bmp      binary
*.pdf      binary
*.doc      binary
*.docx     binary
*.xls      binary
*.xlsx     binary
*.ppt      binary
*.pptx     binary
*.zip      binary
*.gz       binary
*.tar      binary
*.7z       binary
*.rar      binary
*.exe      binary
*.dll      binary
*.so       binary
*.dylib    binary
*.pyc      binary
*.pyd      binary
*.db       binary
*.sqlite   binary
*.sqlite3  binary
